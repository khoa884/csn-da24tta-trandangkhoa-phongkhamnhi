    {
      "name": "1. Đăng nhập Bác sĩ (Lưu Bearer Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "var res = pm.response.json();",
              "pm.test('Đăng nhập thành công với vai trò BAC_SI', function () {",
              "    pm.expect(res.thanhCong).to.eql(true);",
              "    pm.expect(res.vaiTro).to.eql('BAC_SI');",
              "    pm.expect(res.token).to.be.a('string').and.not.empty;",
              "});",
              "if (res && res.token) { pm.collectionVariables.set('token', res.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=UTF-8" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenDangNhap\": \"bacsi1\",\n  \"matKhau\": \"123456\"\n}"
        },
        "url": { "raw": "http://localhost:8080/api/dang-nhap", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "dang-nhap"] }
